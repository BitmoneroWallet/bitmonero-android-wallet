<?xml version="1.0" encoding="utf-8"?>
<!--
     Monero/BitMonero daemon RPC is plain HTTP. monerod's RPC port offers no
     TLS, so a wallet that blocks cleartext cannot reach ANY node: not a
     remote node (the defaults or one the user types in), not a local/LAN
     node. Cleartext must therefore be permitted for node traffic.

     The privacy model here is "trusted vs untrusted node" (via
     setTrustedDaemon) and running your own node, NOT transport TLS, which
     the daemon does not provide. This reverses the earlier cleartext=false
     default, which left the wallet unable to connect to any remote node at
     all. An onion/tor or RPC-over-TLS node, where available, layers on top
     and does not change the cleartext base case.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
