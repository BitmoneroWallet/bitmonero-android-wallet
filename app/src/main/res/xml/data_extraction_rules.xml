<?xml version="1.0" encoding="utf-8"?>
<!-- Belt-and-suspenders alongside allowBackup="false": explicitly exclude
     everything from both cloud backup and device-to-device transfer.
     Matches the iXcoin lesson: a wallet keys file must never leave the
     device via any OS-level backup path, only via a user-initiated,
     explicit export the user chose. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
